\begin{figure*}[hbt]
\ifnextchar[{\eatarg}{}


\caption{\label{fig-type1-sim}Empirical Type I error rates across
inferential methods in the simulation study (\(\alpha = 0.05\)).
Rejection rates for testing the focal moderator coefficient
(\(\beta_X = 0\)) are averaged over sample size per group (\(n\)) and
moderator correlation (\(\rho_{XZ}\)), shown as a function of the number
of studies (\(k\)), baseline heterogeneity (\(\tau_0^2\)), scale
heterogeneity parameter (\(\zeta\)), and fitted model type
(Equal-Effects {[}EE{]} vs.~Random-Effects REML {[}RE--REML{]}). Dotted
horizontal lines indicate the 95\% Monte Carlo confidence interval
around nominal \(\alpha = 0.05\). The Wald test is omitted due to
substantial liberal inflation.}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{pimma_files/figure-pdf/fig-type1-sim-1.pdf}}

}

\end{figure*}
