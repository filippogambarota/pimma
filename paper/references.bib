  date = {1981-06-01},
  doi = {10.3102/10769986006002107},
  abstract = {Glass's estimator of effect size, the sample mean difference
  divided by the sample standard deviation, is studied in the context of an
  explicit statistical model. The exact distribution of Glass's estimator is
  obtained and the estimator is shown to have a small sample bias. The minimum
  variance unbiased estimator is obtained and shown to have uniformly smaller
  variance than Glass's (biased) estimator. Measurement error is shown to
