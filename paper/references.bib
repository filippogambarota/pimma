@ARTICLE{Wicherts2016-cz,
  title = {{Degrees of freedom in planning, running, analyzing, and reporting
  psychological studies: A checklist to avoid p-hacking}},
  author = {Wicherts, Jelte M and Veldkamp, Coosje L S and Augusteijn, Hilde E M
